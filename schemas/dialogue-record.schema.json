{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dialogue Archive Record v0.1",
  "description": "A minimal schema for preserving human-AI dialogues and referencing external questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archive_version",
    "dialogue_id",
    "metadata",
    "visibility",
    "messages",
    "question_links"
  ],
  "properties": {
    "archive_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Dialogue Archive protocol version."
    },
    "dialogue_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Unique dialogue identifier within the validation dataset."
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ],
      "description": "Declared publication visibility. This field does not enforce authorization or access control."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      },
      "description": "Ordered human-AI conversation messages."
    },
    "question_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question_link"
      },
      "description": "Associations between local messages and external question identifiers."
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "created_at",
        "source",
        "tags"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Human-readable dialogue title."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "description": "Declared creation timestamp in RFC 3339 format with an explicit timezone."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Declared source of the archived conversation."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Descriptive tags. An empty array is permitted."
        },
        "content_status": {
          "type": "string",
          "enum": [
            "original",
            "edited",
            "redacted",
            "unknown"
          ],
          "description": "Optional declaration of content transformation status."
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Optional identifier of the declared source record."
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "role",
        "content"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Message identifier unique within the containing dialogue."
        },
        "role": {
          "type": "string",
          "enum": [
            "human",
            "assistant"
          ],
          "description": "Participant role supported by Dialogue Archive v0.1."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Non-empty text content of the message."
        }
      }
    },
    "question_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "question_id"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Identifier of a message in the containing dialogue."
        },
        "question_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Opaque external question identifier."
        }
      }
    }
  }
}
